{
  "name": "OLIST",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "es-CR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "expressions": [
      {
        "name": "CarpetaResultados",
        "kind": "m",
        "expression": "\"C:\\Users\\USER\\Documents\\ChatGPT\\Minería Datos\\resultados\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "Scoring",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "score_if_raw",
            "dataType": "double",
            "sourceColumn": "score_if_raw",
            "summarizeBy": "none",
            "formatString": "0.0000"
          },
          {
            "name": "score_lof_raw",
            "dataType": "double",
            "sourceColumn": "score_lof_raw",
            "summarizeBy": "none",
            "formatString": "0.0000"
          },
          {
            "name": "anomaly_score_if",
            "dataType": "double",
            "sourceColumn": "anomaly_score_if",
            "summarizeBy": "none",
            "formatString": "0.0000"
          },
          {
            "name": "anomaly_score_lof",
            "dataType": "double",
            "sourceColumn": "anomaly_score_lof",
            "summarizeBy": "none",
            "formatString": "0.0000"
          },
          {
            "name": "anomaly_if",
            "dataType": "int64",
            "sourceColumn": "anomaly_if",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "anomaly_lof",
            "dataType": "int64",
            "sourceColumn": "anomaly_lof",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "anomaly_score_final",
            "dataType": "double",
            "sourceColumn": "anomaly_score_final",
            "summarizeBy": "none",
            "formatString": "0.0000"
          },
          {
            "name": "anomalia_consenso",
            "dataType": "int64",
            "sourceColumn": "anomalia_consenso",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "prioridad_modelo",
            "dataType": "string",
            "sourceColumn": "prioridad_modelo",
            "summarizeBy": "none"
          },
          {
            "name": "variables_revision",
            "dataType": "string",
            "sourceColumn": "variables_revision",
            "summarizeBy": "none"
          },
          {
            "name": "flag_diferencia_pago",
            "dataType": "int64",
            "sourceColumn": "flag_diferencia_pago",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "flag_freight_alto",
            "dataType": "int64",
            "sourceColumn": "flag_freight_alto",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "flag_monto_negativo",
            "dataType": "int64",
            "sourceColumn": "flag_monto_negativo",
            "summarizeBy": "none",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Scoring",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Csv.Document(File.Contents(CarpetaResultados & \"\\order_anomaly_scoring.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
                "    Vacios = Table.ReplaceValue(Encabezados, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),",
                "    Tipos = Table.TransformColumnTypes(Vacios, {{\"order_id\", type text}, {\"score_if_raw\", type number}, {\"score_lof_raw\", type number}, {\"anomaly_score_if\", type number}, {\"anomaly_score_lof\", type number}, {\"anomaly_if\", Int64.Type}, {\"anomaly_lof\", Int64.Type}, {\"anomaly_score_final\", type number}, {\"anomalia_consenso\", Int64.Type}, {\"prioridad_modelo\", type text}, {\"variables_revision\", type text}, {\"flag_diferencia_pago\", Int64.Type}, {\"flag_freight_alto\", Int64.Type}, {\"flag_monto_negativo\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Órdenes",
            "expression": "COUNTROWS(Scoring)",
            "formatString": "#,0"
          },
          {
            "name": "Anomalías IF",
            "expression": "SUM(Scoring[anomaly_if])",
            "formatString": "#,0"
          },
          {
            "name": "Anomalías LOF",
            "expression": "SUM(Scoring[anomaly_lof])",
            "formatString": "#,0"
          },
          {
            "name": "Consenso",
            "expression": "SUM(Scoring[anomalia_consenso])",
            "formatString": "#,0"
          },
          {
            "name": "Algún modelo",
            "expression": "[Anomalías IF] + [Anomalías LOF] - [Consenso]",
            "formatString": "#,0"
          },
          {
            "name": "Solo IF",
            "expression": "[Anomalías IF] - [Consenso]",
            "formatString": "#,0"
          },
          {
            "name": "Solo LOF",
            "expression": "[Anomalías LOF] - [Consenso]",
            "formatString": "#,0"
          },
          {
            "name": "Jaccard",
            "expression": "DIVIDE([Consenso], [Algún modelo], 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Porcentaje marcado",
            "expression": "DIVIDE([Algún modelo], [Órdenes], 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Diferencia pago",
            "expression": "SUM(Scoring[flag_diferencia_pago])",
            "formatString": "#,0"
          },
          {
            "name": "Freight alto",
            "expression": "SUM(Scoring[flag_freight_alto])",
            "formatString": "#,0"
          },
          {
            "name": "Monto negativo",
            "expression": "SUM(Scoring[flag_monto_negativo])",
            "formatString": "#,0"
          }
        ]
      },
